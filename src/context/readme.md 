## 4️⃣ Agregado Claim

```ts
// src/claim-context/domain/claim.aggregate.ts
import { IDomainEvent, EventBus } from '../../shared/event-bus/event-bus'

export class Claim {
  constructor(
    public readonly id: string,
    public readonly policyId: string,
    public readonly customerId: string,
    public description: string,
    public status: 'SUBMITTED' | 'APPROVED' | 'REJECTED'
  ) {}

  submit(eventBus: EventBus) {
    const event: IDomainEvent = {
      type: 'ClaimSubmitted',
      payload: { claimId: this.id, policyId: this.policyId, customerId: this.customerId }
    }
    eventBus.publish(event)
    this.status = 'SUBMITTED'
  }
}
```

