## 6️⃣ Use case: registrar pago

```ts
// src/payment-context/application/register-payment.usecase.ts
import { Payment } from '../domain/payment.aggregate'
import { EventBus } from '../../shared/event-bus/event-bus'

export class RegisterPaymentUseCase {
  constructor(private readonly eventBus: EventBus) {}

  execute(paymentId: string, policyId: string, amount: number) {
    const payment = new Payment(paymentId, policyId, amount, 'PENDING')
    payment.register(this.eventBus)
    return payment
  }
}
```

