## 7️⃣ Use case: reportar siniestro

```ts
// src/claim-context/application/submit-claim.usecase.ts
import { Claim } from '../domain/claim.aggregate'
import { EventBus } from '../../shared/event-bus/event-bus'

export class SubmitClaimUseCase {
  constructor(private readonly eventBus: EventBus) {}

  execute(claimId: string, policyId: string, customerId: string, description: string) {
    const claim = new Claim(claimId, policyId, customerId, description, 'SUBMITTED')
    claim.submit(this.eventBus)
    return claim
  }
}
```

