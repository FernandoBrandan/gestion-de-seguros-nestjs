## 8️⃣ Ejemplo de uso con EventBus

```ts
const eventBus = new EventBus()

// Suscribimos handlers para reaccionar a eventos
eventBus.subscribe('PolicyIssued', (e) => console.log('Policy issued', e.payload))
eventBus.subscribe('PaymentRegistered', (e) => console.log('Payment registered', e.payload))
eventBus.subscribe('ClaimSubmitted', (e) => console.log('Claim submitted', e.payload))

// Ejecutamos casos de uso
const issuePolicyUC = new IssuePolicyUseCase(eventBus)
const policy = issuePolicyUC.execute('policy-1', 'customer-1')

const registerPaymentUC = new RegisterPaymentUseCase(eventBus)
registerPaymentUC.execute('payment-1', policy.id, 1000)

const submitClaimUC = new SubmitClaimUseCase(eventBus)
submitClaimUC.execute('claim-1', policy.id, 'customer-1', 'Fire damage in kitchen')
```

