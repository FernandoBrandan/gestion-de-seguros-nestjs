## 3️⃣ Agregado Payment

```ts
// src/payment-context/domain/payment.aggregate.ts
import { IDomainEvent, EventBus } from '../../shared/event-bus/event-bus'

export class Payment {
  constructor(
    public readonly id: string,
    public readonly policyId: string,
    public readonly amount: number,
    public status: 'PENDING' | 'PAID'
  ) {}

  register(eventBus: EventBus) {
    const event: IDomainEvent = {
      type: 'PaymentRegistered',
      payload: { paymentId: this.id, policyId: this.policyId, amount: this.amount }
    }
    eventBus.publish(event)
    this.status = 'PAID'
  }
}
```

