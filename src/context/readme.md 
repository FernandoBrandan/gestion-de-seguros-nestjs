## 5️⃣ Use case: emitir póliza

```ts
// src/policy-context/application/issue-policy.usecase.ts
import { Policy } from '../domain/policy.aggregate'
import { EventBus } from '../../shared/event-bus/event-bus'

export class IssuePolicyUseCase {
  constructor(private readonly eventBus: EventBus) {}

  execute(policyId: string, customerId: string) {
    const coverages = [{ name: 'Fire' }, { name: 'Theft' }]
    const premium = { amount: 1000 }
    const policy = new Policy(policyId, customerId, coverages, premium)
    policy.issue(this.eventBus)
    return policy
  }
}
```

