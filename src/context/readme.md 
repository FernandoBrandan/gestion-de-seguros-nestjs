## 2️⃣ Agregado Policy

```ts
// src/policy-context/domain/policy.aggregate.ts
import { IDomainEvent, EventBus } from '../../shared/event-bus/event-bus'

export interface Coverage { name: string }
export interface Premium { amount: number }

export class Policy {
  public readonly id: string
  public readonly customerId: string
  public coverages: Coverage[]
  public premium: Premium

  constructor(id: string, customerId: string, coverages: Coverage[], premium: Premium) {
    this.id = id
    this.customerId = customerId
    this.coverages = coverages
    this.premium = premium
  }

  issue(eventBus: EventBus) {
    const event: IDomainEvent = {
      type: 'PolicyIssued',
      payload: { policyId: this.id, customerId: this.customerId }
    }
    eventBus.publish(event)
  }
}
```

